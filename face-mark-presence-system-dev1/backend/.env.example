DATABASE_URL=postgresql+psycopg://dev_user:YOUR_PASSWORD@192.168.1.150:5432/presentsir
SECRET_KEY=change-this-to-a-long-random-secret-key


ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.150:8080,https://facemark.app.cloudshiftsolutions.in

STORAGE_BACKEND=minio
MINIO_ENDPOINT=https://s3.app.cloudshiftsolutions.in
MINIO_PUBLIC_URL=https://s3.app.cloudshiftsolutions.in
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=presentsir
MINIO_REGION=us-east-1

FACE_MATCH_THRESHOLD=0.85
FACE_MATCH_MARGIN=0.08
MIN_FACE_SAMPLES=3
MAX_FACE_SAMPLES=8

# Public employee self-registration (default false — admins create employees)
ALLOW_PUBLIC_EMPLOYEE_REGISTRATION=false

# Shared secret for kiosk quick attendance (header: X-Kiosk-Token). Required for /api/attendance/quick.
KIOSK_API_TOKEN=change-me-to-a-long-random-kiosk-token

# Business calendar timezone for attendance / day-status "today"
APP_TIMEZONE=Asia/Kolkata
