# Vite dev server proxies /api and /static to the backend on VITE_PROXY_TARGET.
VITE_API_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8001
VITE_MINIO_PUBLIC_URL=https://s3.app.cloudshiftsolutions.in
VITE_MINIO_BUCKET=presentsir

# Must match backend KIOSK_API_TOKEN (sent as X-Kiosk-Token on /api/attendance/quick)
VITE_KIOSK_TOKEN=change-me-to-a-long-random-kiosk-token
